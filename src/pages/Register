import React, { useState } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import api from '../api/axios';

export default function Register() {
  const [type, setType] = useState('user');
  const [form, setForm] = useState({ username: '', email: '', password: '', first_name: '', last_name: '', phone: '', address: '' });
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const navigate = useNavigate();

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);
    setError('');
    try {
      const endpoint = type === 'user' ? '/auth/register/user/' : '/auth/register/pharmacy/';
      const { data } = await api.post(endpoint, form);
      localStorage.setItem('access_token', data.access);
      localStorage.setItem('refresh_token', data.refresh);
      // الصيدلية تكمل بيانات الـ GPS
      if (type === 'pharmacy') {
        navigate('/pharmacy/setup');
      } else {
        navigate('/upload');
      }
    } catch (err) {
      const msg = err.response?.data;
      setError(JSON.stringify(msg) || 'حصل خطأ في التسجيل');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={styles.container}>
      <div style={styles.card}>
        <h1 style={styles.title}>إنشاء حساب</h1>

        {/* Toggle نوع الحساب */}
        <div style={styles.toggle}>
          <button style={{ ...styles.toggleBtn, ...(type === 'user' ? styles.activeBtn : {}) }} onClick={() => setType('user')} type="button">
            مستخدم عادي
          </button>
          <button style={{ ...styles.toggleBtn, ...(type === 'pharmacy' ? styles.activeBtn : {}) }} onClick={() => setType('pharmacy')} type="button">
            صيدلية
          </button>
        </div>

        <form onSubmit={handleSubmit}>
          <input style={styles.input} placeholder="اسم المستخدم" value={form.username} onChange={e => setForm({ ...form, username: e.target.value })} required />
          <input style={styles.input} type="email" placeholder="الإيميل" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} required />
          <input style={styles.input} type="password" placeholder="كلمة السر" value={form.password} onChange={e => setForm({ ...form, password: e.target.value })} required />

          {type === 'user' && (
            <>
              <input style={styles.input} placeholder="الاسم الأول" value={form.first_name} onChange={e => setForm({ ...form, first_name: e.target.value })} />
              <input style={styles.input} placeholder="الاسم الأخير" value={form.last_name} onChange={e => setForm({ ...form, last_name: e.target.value })} />
              <input style={styles.input} placeholder="رقم التليفون" value={form.phone} onChange={e => setForm({ ...form, phone: e.target.value })} />
              <input style={styles.input} placeholder="العنوان" value={form.address} onChange={e => setForm({ ...form, address: e.target.value })} />
            </>
          )}

          {error && <p style={styles.error}>{error}</p>}
          <button style={styles.btn} type="submit" disabled={loading}>
            {loading ? 'جاري التسجيل...' : 'تسجيل'}
          </button>
        </form>
        <p style={styles.link}>عندك حساب؟ <Link to="/login">دخول</Link></p>
      </div>
    </div>
  );
}

const styles = {
  container: { minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center', background: '#f5f5f5', direction: 'rtl' },
  card: { background: '#fff', padding: '2rem', borderRadius: '12px', boxShadow: '0 2px 16px rgba(0,0,0,0.1)', width: '100%', maxWidth: '420px' },
  title: { textAlign: 'center', marginBottom: '1rem', color: '#1a1a2e' },
  toggle: { display: 'flex', marginBottom: '1.5rem', borderRadius: '8px', overflow: 'hidden', border: '1px solid #4f46e5' },
  toggleBtn: { flex: 1, padding: '0.6rem', background: 'transparent', border: 'none', cursor: 'pointer', fontSize: '0.95rem' },
  activeBtn: { background: '#4f46e5', color: '#fff' },
  input: { width: '100%', padding: '0.75rem', marginBottom: '0.75rem', border: '1px solid #ddd', borderRadius: '8px', fontSize: '1rem', boxSizing: 'border-box', textAlign: 'right' },
  btn: { width: '100%', padding: '0.75rem', background: '#4f46e5', color: '#fff', border: 'none', borderRadius: '8px', fontSize: '1rem', cursor: 'pointer' },
  error: { color: 'red', fontSize: '0.85rem', marginBottom: '0.5rem' },
  link: { textAlign: 'center', marginTop: '1rem' },
};
